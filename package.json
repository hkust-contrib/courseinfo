{
  "name": "courseinfo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test:native": "cargo test --locked -p courseinfo-core",
    "test:worker": "vitest run",
    "test": "bun run test:native && bun run build && bun run test:worker",
    "dev": "wrangler dev --local",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "check": "cargo fmt --all --check && cargo clippy --workspace --target wasm32-unknown-unknown --locked -- -D warnings"
  },
  "devDependencies": {
    "vitest": "3.2.4",
    "wrangler": "4.137.0"
  }
}
